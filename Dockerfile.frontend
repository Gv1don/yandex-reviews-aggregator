FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

RUN node -e " \
    const m = require('./public/build/manifest.json'); \
    const css = m['resources/css/app.css']?.file; \
    const js  = m['resources/js/app.js']?.file; \
    const fs = require('fs'); \
    const link = css ? '<link rel=\"stylesheet\" href=\"/' + css + '\">' : ''; \
    fs.writeFileSync('./public/build/index.html', \
      '<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Rating Service</title>\n' + link + '\n</head>\n<body>\n<div id=\"app\"></div>\n<script type=\"module\" src=\"/' + js + '\"><\/script>\n</body>\n</html>'); \
"

FROM nginx:1.27-alpine

COPY --from=build /app/public/build /var/www/html
COPY .docker/frontend/nginx.conf /etc/nginx/conf.d/default.conf
